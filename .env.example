# Clé API Anthropic (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé pour l'indexation visuelle des planches contact
VISION_MODEL=claude-opus-5-5

# Modèle utilisé pour générer la timeline de montage
DIRECTOR_MODEL=claude-opus-5-5

# Optionnel : chemin d'un Chrome Headless Shell pour Remotion (sinon auto-détection / téléchargement)
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome-headless-shell
